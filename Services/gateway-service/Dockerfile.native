# GraalVM Native Image Build for gateway-service (linux/amd64, Ubuntu 24.04)
# Note: Spring Cloud Gateway has limited GraalVM native support.
# May require additional --initialize-at-build-time flags.
FROM ghcr.io/graalvm/native-image-community:17-ol9 AS builder
WORKDIR /build
RUN microdnf install -y maven && microdnf clean all
COPY pom.xml .
COPY Frameworks/pom.xml ./Frameworks/pom.xml
COPY Frameworks/cache/pom.xml ./Frameworks/cache/pom.xml
COPY Frameworks/common/pom.xml ./Frameworks/common/pom.xml
COPY Frameworks/database/pom.xml ./Frameworks/database/pom.xml
COPY Frameworks/Idempotent/pom.xml ./Frameworks/Idempotent/pom.xml
COPY Frameworks/log/pom.xml ./Frameworks/log/pom.xml
COPY Frameworks/mq/pom.xml ./Frameworks/mq/pom.xml
COPY Services/pom.xml ./Services/pom.xml
COPY Services/gateway-service/pom.xml ./Services/gateway-service/pom.xml
RUN --mount=type=cache,target=/root/.m2/repository mvn dependency:go-offline -B -pl Services/gateway-service -am || true
COPY Frameworks ./Frameworks
COPY Services ./Services
RUN --mount=type=cache,target=/root/.m2/repository mvn -Pnative package -pl Services/gateway-service -am -DskipTests -Dmaven.test.skip=true

FROM ubuntu:noble AS runtime
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -r appuser && useradd -r -g appuser -d /app appuser
WORKDIR /app
COPY --from=builder /build/Services/gateway-service/target/gateway-service /app/server
RUN chown -R appuser:appuser /app
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health || exit 1
ENTRYPOINT ["/app/server"]

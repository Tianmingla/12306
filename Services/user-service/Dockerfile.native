# ================================================================
# GraalVM Native Image Build for user-service
# Target: linux/amd64 (Ubuntu 24.04)
#
# Prerequisite (run once locally with MySQL/Redis/Nacos running):
#   mvn clean package -pl Services/user-service -am -DskipTests
#   java -agentlib:native-image-agent=config-merge-dir=Services/user-service/src/main/resources/META-INF/native-image \
#     -jar Services/user-service/target/user-service-1.0-SNAPSHOT.jar
#   → Hit all API endpoints to exercise code paths
#   → Ctrl+C to stop, agent writes configs
#   → Commit the generated JSON files
# ================================================================

# Stage 1: Build native image with GraalVM + Maven
FROM ghcr.io/graalvm/native-image-community:17-ol9 AS builder
WORKDIR /build

RUN microdnf install -y maven && microdnf clean all

# Copy pom files first for layer caching
COPY pom.xml .
COPY Frameworks/pom.xml ./Frameworks/pom.xml
COPY Frameworks/cache/pom.xml ./Frameworks/cache/pom.xml
COPY Frameworks/common/pom.xml ./Frameworks/common/pom.xml
COPY Frameworks/database/pom.xml ./Frameworks/database/pom.xml
COPY Frameworks/Idempotent/pom.xml ./Frameworks/Idempotent/pom.xml
COPY Frameworks/log/pom.xml ./Frameworks/log/pom.xml
COPY Frameworks/mq/pom.xml ./Frameworks/mq/pom.xml
COPY Services/pom.xml ./Services/pom.xml
COPY Services/user-service/pom.xml ./Services/user-service/pom.xml

RUN --mount=type=cache,target=/root/.m2/repository mvn dependency:go-offline -B -pl Services/user-service -am || true

COPY Frameworks ./Frameworks
COPY Services ./Services

# Build native image (package phase triggers compile-no-fork via native profile)
RUN --mount=type=cache,target=/root/.m2/repository mvn -Pnative package -pl Services/user-service -am -DskipTests -Dmaven.test.skip=true

# ================================================================
# Stage 2: Minimal Ubuntu 24.04 runtime
# ================================================================
FROM ubuntu:noble AS runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -r appuser && useradd -r -g appuser -d /app appuser

WORKDIR /app
COPY --from=builder /build/Services/user-service/target/user-service /app/server
RUN chown -R appuser:appuser /app

USER appuser
EXPOSE 8084

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8084/actuator/health || exit 1

ENTRYPOINT ["/app/server"]
